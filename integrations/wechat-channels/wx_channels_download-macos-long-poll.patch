+func (c *ChannelsClient) deliverResponse(resp ClientWebsocketResponse) {
+	if resp.Id == "" {
+		return
+	}
+	c.requests_mu.RLock()
+	ch, ok := c.requests[resp.Id]
+	c.requests_mu.RUnlock()
+	if ok {
+		ch <- resp
+	}
+}
+
+func (c *ChannelsClient) HandleChannelsPoll(ctx *gin.Context) {
+	c.poll_mu.Lock()
+	c.poll_last_seen = time.Now()
+	c.poll_mu.Unlock()
+	select {
+	case msg := <-c.poll_send:
+		ctx.Data(http.StatusOK, "application/json; charset=utf-8", msg)
+	case <-time.After(20 * time.Second):
+		ctx.Status(http.StatusNoContent)
+	case <-ctx.Request.Context().Done():
+		return
+	}
+}
+
+func (c *ChannelsClient) HandleChannelsPollResponse(ctx *gin.Context) {
+	var resp ClientWebsocketResponse
+	if err := ctx.ShouldBindJSON(&resp); err != nil {
+		ctx.JSON(http.StatusBadRequest, gin.H{"code": 1, "msg": err.Error()})
+		return
+	}
+	c.deliverResponse(resp)
+	ctx.JSON(http.StatusOK, gin.H{"code": 0, "msg": "ok"})
+}
